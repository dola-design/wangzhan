# 依赖目录（React/Vite 等会生成，体积大，不该提交）
node_modules/

# 构建产物（打包后生成，可由源码重新生成）
dist/
build/

# 环境变量文件（可能含 API Key 等密钥，绝对不能提交）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 操作系统自动生成的文件
.DS_Store
Thumbs.db

# 编辑器 / IDE 配置
.vscode/
.idea/
*.swp

# 日志文件
*.log
npm-debug.log*

# 临时文件
*.tmp
